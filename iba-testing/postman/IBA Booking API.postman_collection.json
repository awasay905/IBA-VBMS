      "name": "1. Auth",
      "item": [
        {
          "name": "Student Login (TC-AUTH-001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r",
                  "pm.test(\"Has access_token\", () => pm.expect(pm.response.json().access_token).to.be.a('string'));\r",
                  "pm.test(\"Role is student\", () => pm.expect(pm.response.json().user.role).to.equal('student'));\r",
                  "pm.test(\"No password in response\", () => pm.expect(pm.response.json().user).to.not.have.property('password'));\r",
                  "\r",
                  "// Save token and user ID for subsequent requests\r",
                  "pm.environment.set(\"token\", pm.response.json().access_token);\r",
                  "pm.environment.set(\"student_id\", pm.response.json().user.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"erp\": \"test-student\", \"password\": \"testpass\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
