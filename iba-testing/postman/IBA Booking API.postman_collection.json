    {
      "name": "2. Buildings",
      "item": [
        {
          "name": "List Buildings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "// 1. Basic Status Check\r",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r",
                  "\r",
                  "// 2. Data Integrity Check (Matching seedTestData.sql)\r",
                  "pm.test(\"Response contains the Seed Building\", () => {\r",
                  "    // Find the building we inserted via SQL\r",
                  "    const testBuilding = jsonData.find(b => b.name === \"Test Building\");\r",
                  "    \r",
                  "    pm.expect(testBuilding).to.be.ok; // Asserts the building was found\r",
                  "    pm.expect(testBuilding.location).to.equal(\"Main Campus\");\r",
                  "    \r",
                  "});\r",
                  "\r",
                  "pm.test(\"Seed Building contains nested rooms from SQL\", () => {\r",
                  "    const testBuilding = jsonData.find(b => b.name === \"Test Building\");\r",
                  "    \r",
                  "    // The backend BuildingsService joins the rooms table\r",
                  "    pm.expect(testBuilding.rooms).to.be.an('array');\r",
                  "    \r",
                  "    const roomNames = testBuilding.rooms.map(r => r.name);\r",
                  "    pm.expect(roomNames).to.include(\"Test Room A\");\r",
                  "    pm.expect(roomNames).to.include(\"Test Room B\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/buildings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "buildings"
              ]
            }
          },
          "response": []
        },
