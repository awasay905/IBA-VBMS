{
    "compilerOptions": {
        "module": "node16",
        "moduleResolution": "node16",
        "target": "ES2021",
        "lib": ["ES2021"],
        "strict": false,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "types": ["jest"], 
        "paths": {
            "@backend/*": ["../iba-backend/src/*"]
        },
        "rootDir": "../",
        "outDir": "./dist"
    },
    "include": ["unit/**/*", "integration/**/*"],
    "exclude": ["node_modules", "e2e"]
}
