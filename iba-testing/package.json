{
    "name": "iba-testing",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "db:init": "ts-node scripts/seedDb.ts --init",
        "db:seed": "ts-node scripts/seedDb.ts --seed",
        "test:unit": "jest --selectProjects unit --passWithNoTests",
        "test:integration": "jest --selectProjects integration --passWithNoTests",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:report": "playwright show-report reports/playwright",
        "test:e2e:codegen": "playwright codegen http://localhost:5173",
        "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/testing": "^11.1.23",
        "@playwright/test": "^1.60.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/jest": "^30.0.0",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^7.2.0",
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.4.2",
        "dotenv-cli": "^11.0.0",
        "jest": "^30.4.2",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "pg": "^8.21.0"
    }
}
